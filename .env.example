# ==========================================
# CodeSentinel - Environment Configuration
# ==========================================
# PLACEHOLDERS ONLY. NEVER COMMIT REAL CREDENTIALS.
# Copy this file to .env for local development.

# --- Application Runtime ---
CODESENTINEL_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL 16+) ---
POSTGRES_USER=codesentinel
POSTGRES_PASSWORD=codesentinel_dev_password
POSTGRES_DB=codesentinel_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://codesentinel:codesentinel_dev_password@localhost:5432/codesentinel_dev
TEST_DATABASE_URL=postgresql+psycopg://codesentinel:codesentinel_dev_password@localhost:5432/codesentinel_test

# --- Distributed Queue & Worker (PostgreSQL Durable Queue) ---
# Supported QUEUE_BACKEND values:
#   "database"   - primary durable PostgreSQL/database queue consumed by background worker daemon
#   "background" - in-process fallback using FastAPI BackgroundTasks for local analysis testing
QUEUE_BACKEND=database
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=codesentinel_jobs
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_DEFAULT_JOB_TIMEOUT_SECONDS=300
WORKER_DEFAULT_MAX_ATTEMPTS=3
WORKER_DEFAULT_RETRY_DELAY_SECONDS=5
WORKER_INTERRUPTED_RECOVERY_INTERVAL_SECONDS=30

# --- Session & Security ---
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=change-this-to-a-secure-32-byte-hex-string-for-sessions
SESSION_COOKIE_NAME=codesentinel_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=604800
ALLOW_DEMO_DEV_FALLBACK=true
FRONTEND_BASE_URL=http://localhost:5173

# --- GitHub App Integration ---
# Register at: https://github.com/settings/apps
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.exampleclientid
GITHUB_APP_CLIENT_SECRET=example-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=
# Raw webhook HMAC secret configured in the GitHub App
GITHUB_WEBHOOK_SECRET=example-webhook-signing-secret
# Path to GitHub App RSA private key (PEM format) or raw base64 content
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/github-app-private-key.pem

# --- Nebius Token Factory & NVIDIA Open Model ---
# Account credentials for Nebius Token Factory (https://api.tokenfactory.nebius.com)
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_TOKEN_FACTORY_API_KEY=placeholder-nebius-token-factory-key
# Selected eligible NVIDIA open-source model from live account catalog
NEBIUS_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_TIMEOUT_SECONDS=45
NEBIUS_MAX_RETRIES=2
NEBIUS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
NEBIUS_CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# --- Execution Runner Boundaries ---
# Base directory for runner workspace isolation (optional in development; required in production)
# RUNNER_WORKSPACE_ROOT=/path/to/workspaces

RUNNER_MAX_EXECUTION_TIME_SECONDS=300
RUNNER_MAX_OUTPUT_BYTES=262144
RUNNER_MEMORY_LIMIT=2g
RUNNER_CPU_LIMIT=2.0
