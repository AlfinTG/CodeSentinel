# ==============================================================================
# CodeSentinel - Production Secret Governance & Deployment Configuration
# ==============================================================================
# STRICTLY ENFORCED: ZERO-PLAINTEXT SECRETS ON DISK IN PRODUCTION.
#
# In production, sensitive secrets (DB passwords, HMAC keys, API keys, private keys)
# must NOT be stored in plaintext .env files on host filesystems.
#
# Configure SECRET_PROVIDER to resolve secrets directly from your cloud KMS
# or secrets manager at application initialization.
# ==============================================================================

# --- Application Runtime (Strict Production Mode) ---
CODESENTINEL_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://app.codesentinel.io,https://dashboard.codesentinel.io

# --- Secret Governance & KMS Resolution ---
# Supported providers:
#   "aws_secrets_manager" - AWS Secrets Manager (fetches JSON payload via IAM/boto3)
#   "gcp_secret_manager"  - Google Cloud Secret Manager (fetches via ADC / service account)
#   "vault"               - HashiCorp Vault KV v2 (fetches via VAULT_ADDR and VAULT_TOKEN / AppRole)
#   "env"                 - Environment variables injected via container orchestrator (e.g., K8s Secret)
SECRET_PROVIDER=aws_secrets_manager

# KMS / Secret Manager identifiers
# For AWS: Secret ARN or Name (e.g., "arn:aws:secretsmanager:us-east-1:123456789012:secret:codesentinel/prod")
# For GCP: Secret ID (e.g., "codesentinel-prod-secrets")
# For Vault: Secret path (e.g., "secret/data/codesentinel/production")
SECRET_MANAGER_SECRET_ID=codesentinel/production
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/example-kms-key-id

# HashiCorp Vault Specific (if SECRET_PROVIDER=vault)
# VAULT_ADDR=https://vault.internal.corp:8200
# VAULT_TOKEN=s.exampletokenfromapprole

# AWS Specific (if SECRET_PROVIDER=aws_secrets_manager)
AWS_SECRETS_REGION=us-east-1

# GCP Specific (if SECRET_PROVIDER=gcp_secret_manager)
# GCP_SECRETS_PROJECT_ID=my-gcp-project-id

# --- Dynamic Secrets Resolved via KMS ---
# The following keys should be stored in your Secret Manager JSON payload:
# {
#   "DATABASE_URL": "postgresql+psycopg://codesentinel_app:<STRONG_PASSWORD>@db.internal:5432/codesentinel_prod?sslmode=require",
#   "SESSION_SECRET_KEY": "<MIN_32_BYTES_HEX_GENERATED_VIA_OPENSSL>",
#   "GITHUB_WEBHOOK_SECRET": "<CRYPTOGRAPHICALLY_RANDOM_HMAC_SECRET>",
#   "GITHUB_APP_CLIENT_SECRET": "<GITHUB_APP_OAUTH_CLIENT_SECRET>",
#   "GITHUB_APP_PRIVATE_KEY": "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----",
#   "NEBIUS_TOKEN_FACTORY_API_KEY": "<NEBIUS_TOKEN_FACTORY_PROD_KEY>",
#   "REDIS_URL": "rediss://default:<REDIS_PASSWORD>@redis.internal:6379/0"
# }

# Fallback direct injection (if deploying via Kubernetes Secrets / ECS Task Definition environment):
# DATABASE_URL=postgresql+psycopg://codesentinel_app:REPLACE_WITH_STRONG_PASSWORD@db.internal:5432/codesentinel_prod?sslmode=require
# SESSION_SECRET_KEY=REPLACE_WITH_MIN_32_CHAR_HEX_GENERATED_SECRET
# GITHUB_WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_WEBHOOK_SECRET

# --- Database & Connection Pooling ---
# Must use TLS/SSL in production (?sslmode=require or verify-full)
# DATABASE_URL=postgresql+psycopg://codesentinel_app:secret@db.internal:5432/codesentinel_prod?sslmode=require

# --- Distributed Queue & Worker ---
QUEUE_BACKEND=database
# REDIS_URL=rediss://default:secret@redis.internal:6379/0
REDIS_QUEUE_NAME=codesentinel_jobs
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_DEFAULT_JOB_TIMEOUT_SECONDS=300
WORKER_DEFAULT_MAX_ATTEMPTS=3
WORKER_DEFAULT_RETRY_DELAY_SECONDS=5
WORKER_INTERRUPTED_RECOVERY_INTERVAL_SECONDS=30

# --- Security & Session Policies ---
# Production cookies MUST be secure (HTTPS only) with SameSite=lax or strict
SESSION_COOKIE_NAME=__Host-codesentinel_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=604800
ALLOW_DEMO_DEV_FALLBACK=false
FRONTEND_BASE_URL=https://app.codesentinel.io

# --- GitHub App Integration ---
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.productionclientid
GITHUB_OAUTH_REDIRECT_URI=https://api.codesentinel.io/auth/github/callback

# --- AI Provider (Nebius Token Factory & NVIDIA Models) ---
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_TIMEOUT_SECONDS=45
NEBIUS_MAX_RETRIES=2
NEBIUS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
NEBIUS_CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# --- Execution Runner Isolation Boundaries ---
# Strictly requires container runtime (docker/podman) and configured root boundary in production
RUNNER_CONTAINER_RUNTIME=docker
RUNNER_WORKSPACE_ROOT=/var/lib/codesentinel/workspaces
RUNNER_CONTAINER_IMAGE=python:3.12-slim
RUNNER_CONTAINER_MEMORY_LIMIT=1g
RUNNER_CONTAINER_CPU_LIMIT=1.0
RUNNER_CONTAINER_PID_LIMIT=64
RUNNER_CONTAINER_TMPFS_SIZE=64m
RUNNER_NETWORK_ENABLED=false
RUNNER_CONTAINER_READ_ONLY_ROOT=true
RUNNER_CONTAINER_USER=10001:10001
RUNNER_CONTAINER_CAP_DROP_ALL=true
RUNNER_CONTAINER_NO_NEW_PRIVILEGES=true
RUNNER_FAIL_CLOSED_ON_MISSING_RUNTIME=true

# ==============================================================================
# Automated Secret Rotation Runbook
# ==============================================================================
# 1. Webhook HMAC Secret:
#    - Generate new 32+ byte hex secret: `openssl rand -hex 32`
#    - Update secret in cloud Secret Manager / Vault.
#    - Update secret in GitHub App settings (webhook configuration).
#    - Rolling restart API pods; CodeSentinel resolves the new key immediately.
#
# 2. Database Passwords:
#    - Provision secondary DB user or alternate password in PostgreSQL.
#    - Update KMS Secret entry with new connection URL string.
#    - Trigger graceful reload/restart of application workers.
#    - Revoke previous DB user credential after zero active connections remain.
#
# 3. Session Signing Secret:
#    - Generate new secret: `openssl rand -hex 32`
#    - Note: Invalidate active user sessions upon rotation, requiring re-authentication.
# ==============================================================================
